---
import type { GetStaticPaths } from 'astro'
import Layout from '../../../layouts/Layout.astro'
import TreatmentDetail from '../../../components/treatments/TreatmentDetail.astro'
import { detailJsonLd, detailMeta } from '../../../components/treatments/helpers'
import { treatments, type Treatment } from '../../../data/treatments'
import { treatmentPath } from '../../../i18n'

export const getStaticPaths = (() =>
  treatments.map((treatment) => ({
    params: { slug: treatment.slug.en },
    props: { treatment },
  }))) satisfies GetStaticPaths

interface Props {
  treatment: Treatment
}
const { treatment } = Astro.props
const meta = detailMeta('en', treatment)
---

<Layout
  lang="en"
  title={meta.title}
  description={meta.description}
  altPath={treatmentPath('es', treatment.slug.es)}
  headerTheme="light"
  ogImage={treatment.detailImg ?? treatment.img}
  jsonLd={detailJsonLd('en', treatment)}
>
  <TreatmentDetail lang="en" treatment={treatment} />
</Layout>
