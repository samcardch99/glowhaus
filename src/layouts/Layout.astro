---
import '../styles/global.css'
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'
import ContactSection from '../components/sections/ContactSection.astro'
import ogDefault from '../assets/clinica-sala.jpg'
import { getImage } from 'astro:assets'
import { site } from '../data/site'
import { useT, type Lang } from '../i18n'

interface Props {
  lang: Lang
  title: string
  description: string
  /** Ruta equivalente en el otro idioma */
  altPath: string
  headerTheme?: 'overlay' | 'light' | 'dark'
  /** Añade la sección de contacto antes del pie (casi todas las páginas la llevan) */
  contact?: boolean
  /** Imagen para redes sociales */
  ogImage?: ImageMetadata
  /** Datos estructurados JSON-LD propios de la página */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  noindex?: boolean
}

const {
  lang,
  title,
  description,
  altPath,
  headerTheme = 'light',
  contact = true,
  ogImage = ogDefault,
  jsonLd,
  noindex = false,
} = Astro.props
const t = useT(lang)
// El dominio temporal de Hostinger no debe indexarse
const staging = Astro.site?.hostname.endsWith('hostingersite.com') ?? false

const canonical = new URL(Astro.url.pathname, Astro.site)
const alternate = new URL(altPath, Astro.site)
const esUrl = lang === 'es' ? canonical : alternate
const enUrl = lang === 'en' ? canonical : alternate
const og = await getImage({ src: ogImage, width: 1200, height: 630, format: 'jpg', fit: 'cover' })
const ogUrl = new URL(og.src, Astro.site)

// Negocio local: va en todas las páginas
const business = {
  '@context': 'https://schema.org',
  '@type': ['MedicalBusiness', 'BeautySalon'],
  '@id': `${site.url}/#clinic`,
  name: site.name,
  url: site.url,
  image: ogUrl.href,
  logo: new URL('/apple-touch-icon.png', Astro.site).href,
  telephone: '+1-786-918-2997',
  email: site.email,
  priceRange: '$$',
  currenciesAccepted: 'USD',
  paymentAccepted: 'Cash, Credit Card, Cherry financing',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.zip,
    addressCountry: site.address.country,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '18:00',
    },
  ],
  sameAs: [site.instagram],
  areaServed: { '@type': 'City', name: 'Miami' },
  founder: { '@type': 'Person', name: 'Alain Castellat', jobTitle: 'APRN, FNP-C' },
  knowsLanguage: ['es', 'en'],
}
const ld = [business, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])]
const fullTitle = title.includes('GlowHaus') ? title : `${title} · GlowHaus Aesthetics Miami`
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js')
      // Si el JS de animación no llega a cargar, se muestra todo igualmente
      setTimeout(function () {
        if (!window.__ghMotion) document.documentElement.classList.remove('js', 'gh-intro-on')
      }, 4000)
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {(noindex || staging) && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <meta name="theme-color" content="#18120E" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GlowHaus Aesthetics" />
    <meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_US'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body class="bg-cream text-ink">
    <a
      href="#main"
      class="bg-ink text-cream focus:outline-gold sr-only z-[300] rounded-lg px-4 py-3 focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {t('Saltar al contenido')}
    </a>
    <Header lang={lang} altPath={altPath} theme={headerTheme} />
    <main id="main">
      <slot />
      {contact && <ContactSection lang={lang} />}
    </main>
    <Footer lang={lang} altPath={altPath} />

    <script>
      import '../scripts/site'
    </script>
  </body>
</html>
