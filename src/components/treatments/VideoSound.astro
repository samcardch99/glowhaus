---
import { useT, type Lang } from '../../i18n'

// Botón de sonido de un vídeo (site.ts le da el comportamiento por
// data-video-sound). El vídeo arranca en silencio; aria-pressed="true" = con sonido.
interface Props {
  lang: Lang
  /** id del <video> */
  controls: string
  class?: string
}
const { lang, controls, class: cls = '' } = Astro.props
const t = useT(lang)
---

<button
  type="button"
  data-video-sound
  aria-controls={controls}
  aria-pressed="false"
  aria-label={t('Activar o silenciar el sonido del vídeo')}
  class:list={[
    'group/vs text-cream hover:bg-gold hidden size-11 items-center justify-center rounded-full border border-[rgb(250_248_245/0.55)] bg-[rgb(24_18_14/0.35)] backdrop-blur-[10px] transition-colors [.js_&]:inline-flex',
    cls,
  ]}
>
  <svg
    viewBox="0 0 20 20"
    width="18"
    height="18"
    aria-hidden="true"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M3.5 7.5h3l4-3.5v12l-4-3.5h-3z" fill="currentColor" stroke="none"></path>
    <path class="group-aria-pressed/vs:hidden" d="M13.5 7.5l4 5M17.5 7.5l-4 5"></path>
    <path
      class="hidden group-aria-pressed/vs:block"
      d="M13.5 7.2a4 4 0 0 1 0 5.6M15.6 5.2a7 7 0 0 1 0 9.6"
    ></path>
  </svg>
</button>
