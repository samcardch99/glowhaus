---
import { useT, type Lang } from '../../i18n'

// Botón de pausa de un vídeo en bucle (site.ts le da el comportamiento por
// data-video-toggle). aria-pressed="true" = vídeo en pausa.
interface Props {
  lang: Lang
  /** id del <video> */
  controls: string
  tone?: 'light' | 'dark'
  class?: string
}
const { lang, controls, tone = 'light', class: cls = '' } = Astro.props
const t = useT(lang)
---

<button
  type="button"
  data-video-toggle
  aria-controls={controls}
  aria-pressed="false"
  aria-label={t('Pausar o reanudar el vídeo')}
  class:list={[
    'group/vt hidden size-11 items-center justify-center rounded-full backdrop-blur-[10px] transition-colors [.js_&]:inline-flex',
    tone === 'light'
      ? 'text-cream hover:bg-gold border border-[rgb(250_248_245/0.55)] bg-[rgb(24_18_14/0.35)]'
      : 'text-ink hover:bg-gold hover:text-cream border border-[rgb(24_18_14/0.4)] bg-[rgb(250_248_245/0.6)]',
    cls,
  ]}
>
  <svg
    viewBox="0 0 20 20"
    width="18"
    height="18"
    aria-hidden="true"
    class="group-aria-pressed/vt:hidden"
    fill="currentColor"
  >
    <rect x="5" y="4" width="3.2" height="12" rx="1"></rect>
    <rect x="11.8" y="4" width="3.2" height="12" rx="1"></rect>
  </svg>
  <svg
    viewBox="0 0 20 20"
    width="18"
    height="18"
    aria-hidden="true"
    class="hidden group-aria-pressed/vt:block"
    fill="currentColor"
  >
    <path d="M6 4.5v11l9-5.5z"></path>
  </svg>
</button>
