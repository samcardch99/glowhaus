---
import { Image } from 'astro:assets'
import visa from '../../assets/pay/visa.png'
import mastercard from '../../assets/pay/mastercard.png'
import amex from '../../assets/pay/amex.png'
import discover from '../../assets/pay/discover.png'
import cherryLogo from '../../assets/pay/cherry-trim.png'
import careCreditLogo from '../../assets/pay/carecredit-trim.png'
import Arrow from '../ui/Arrow.astro'
import { site } from '../../data/site'
import { useT, type Lang } from '../../i18n'

// Tarjeta oscura «Formas de pago»: tarjeta, efectivo, cuotas con Cherry y
// financiamiento con CareCredit. Como en el diseño, Cherry y CareCredit se
// destacan en dorado por turnos cada 2,5 s (en escritorio, y en móvil la más
// cercana al centro); al pasar el ratón por una se marca en marrón y la
// rotación se pausa 4 s. Todo el recuadro de Cherry y de CareCredit es el
// enlace. Sin JS o con movimiento reducido no rota.
interface Props {
  lang: Lang
  class?: string
  [key: string]: unknown
}
const { lang, class: cls = '', ...rest } = Astro.props
const t = useT(lang)
const cards = [
  { src: visa, alt: 'Visa' },
  { src: mastercard, alt: 'Mastercard' },
  { src: amex, alt: 'American Express' },
  { src: discover, alt: 'Discover' },
]
const tile = 'flex flex-col gap-1 rounded-[12px] px-[18px] py-4 max-[759px]:px-4'
const sub = 'm-0 text-[clamp(17px,calc(12px+0.8vw),18px)] leading-[1.55]'
const logo = 'block h-[22px] w-auto rounded-[3px] bg-white px-2.5 py-1 [box-sizing:content-box]'
---

<div
  data-pay
  class:list={[
    'bg-brown text-cream flex flex-col justify-center gap-[18px] rounded-[14px] p-[clamp(22px,3vw,40px)]',
    cls,
  ]}
  {...rest}
>
  <span class="eyebrow text-tan">{t('FORMAS DE PAGO')}</span>
  <h2 class="text-gold m-0 text-[30px] leading-[1.15] font-semibold">{t('Paga como prefieras')}</h2>
  <ul class="m-0 flex list-none flex-col gap-2.5 p-0">
    <li class:list={[tile, 'pay-static']}>
      <h3 class="m-0 text-[18.5px] font-semibold">{t('Tarjeta de crédito o débito')}</h3>
      <p class:list={[sub, 'text-beige']}>{t('Visa, Mastercard, American Express y Discover.')}</p>
      <div class="mt-1.5 flex flex-wrap gap-2">
        {cards.map((c) => (
          <Image src={c.src} alt={c.alt} height={60} class="block h-[30px] w-auto rounded-[3px]" />
        ))}
      </div>
    </li>
    <li class:list={[tile, 'pay-static']}>
      <h3 class="m-0 text-[18.5px] font-semibold">{t('Efectivo')}</h3>
      <p class:list={[sub, 'text-beige']}>{t('Al momento de tu cita, en la clínica.')}</p>
    </li>
    <li>
      <a
        data-pay-i="0"
        href={site.cherry}
        target="_blank"
        rel="noopener"
        class:list={[tile, 'pay-tile text-cream no-underline']}
      >
        <h3 class="m-0 flex items-center gap-2 text-[18.5px] font-semibold">
          {t('En cuotas con Cherry')}
          <Arrow />
        </h3>
        <p class:list={[sub, 'pay-sub']}>
          {t(
            'Divide el costo de tu paquete en pagos mensuales. La solicitud se hace en línea y te responden en minutos.',
          )}
        </p>
        <div class="mt-1.5 flex">
          <Image src={cherryLogo} alt="Cherry" height={44} class={logo} />
        </div>
      </a>
    </li>
    <li>
      <a
        data-pay-i="1"
        href={site.careCredit}
        target="_blank"
        rel="noopener"
        class:list={[tile, 'pay-tile text-cream no-underline']}
      >
        <h3 class="m-0 flex items-center gap-2 text-[18.5px] font-semibold">
          {t('Financiamiento con CareCredit')}
          <Arrow />
        </h3>
        <p class:list={[sub, 'pay-sub']}>
          {t(
            'Tarjeta de crédito para tratamientos de salud y estética. Puedes solicitarla en línea y usarla en tu cita.',
          )}
        </p>
        <div class="mt-1.5 flex">
          <Image src={careCreditLogo} alt="CareCredit" height={44} class={logo} />
        </div>
      </a>
    </li>
  </ul>
</div>

<style>
  .pay-static {
    border-top: 1px solid rgb(250 248 245 / 0.16);
    border-radius: 0;
  }
  .pay-tile {
    border-top: 1px solid rgb(250 248 245 / 0.16);
    transition:
      background-color 0.5s,
      box-shadow 0.5s;
  }
  .pay-sub {
    color: var(--color-beige);
    transition: color 0.5s;
  }
  .pay-tile[data-active] {
    background: var(--color-gold);
    box-shadow: inset 0 0 0 1px rgb(250 248 245 / 0.35);
  }
  .pay-tile[data-active] .pay-sub {
    color: var(--color-cream);
  }
  .pay-tile[data-hover]:not([data-active]) {
    background: rgb(24 18 14 / 0.5);
    box-shadow: inset 0 0 0 1px rgb(250 248 245 / 0.35);
  }
  .pay-tile:focus-visible {
    outline: 2px solid var(--color-gold-light);
    outline-offset: 2px;
  }
</style>

<script>
  import { prefersReducedMotion } from '../../scripts/gsap'

  const reduce = prefersReducedMotion()
  const desktop = window.matchMedia('(min-width: 760px)')

  document.querySelectorAll<HTMLElement>('[data-pay]').forEach((box) => {
    const tiles = Array.from(box.querySelectorAll<HTMLElement>('[data-pay-i]'))
    if (!tiles.length) return
    let idx = 0
    let pausedUntil = 0
    let visible = false
    let timer = 0

    const set = (i: number) => {
      idx = (i + tiles.length) % tiles.length
      tiles.forEach((el, k) => el.toggleAttribute('data-active', k === idx))
    }
    set(0)

    // Al pasar el ratón se marca en marrón; al salir, la rotación espera 4 s.
    // Con el foco del teclado, se destaca en dorado.
    tiles.forEach((el, k) => {
      el.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') el.toggleAttribute('data-hover', true)
      })
      el.addEventListener('pointerleave', () => {
        el.removeAttribute('data-hover')
        pausedUntil = Date.now() + 4000
      })
      el.addEventListener('focusin', () => {
        pausedUntil = Date.now() + 4000
        set(k)
      })
    })

    // Escritorio: Cherry y CareCredit se turnan cada 2,5 s solo si se ve y la pestaña está activa
    const tick = () => {
      if (Date.now() < pausedUntil || tiles.some((el) => el.hasAttribute('data-hover'))) return
      set(idx + 1)
    }
    const sync = () => {
      const run = !reduce && desktop.matches && visible && !document.hidden
      if (run && !timer) timer = window.setInterval(tick, 2500)
      if (!run && timer) {
        window.clearInterval(timer)
        timer = 0
      }
    }
    new IntersectionObserver(([e]) => {
      visible = !!e?.isIntersecting
      sync()
    }).observe(box)
    document.addEventListener('visibilitychange', sync)
    desktop.addEventListener('change', sync)

    // Móvil: la forma de pago más cercana al centro de la pantalla
    let raf = 0
    const nearest = () => {
      raf = 0
      if (desktop.matches || !visible) return
      const mid = window.innerHeight / 2
      let best = -1
      let bd = Infinity
      tiles.forEach((el, k) => {
        const r = el.getBoundingClientRect()
        if (r.bottom < 0 || r.top > window.innerHeight) return
        const d = Math.abs(r.top + r.height / 2 - mid)
        if (d < bd) {
          bd = d
          best = k
        }
      })
      if (best >= 0 && best !== idx) set(best)
    }
    window.addEventListener(
      'scroll',
      () => {
        if (!raf) raf = requestAnimationFrame(nearest)
      },
      { passive: true },
    )
  })
</script>
