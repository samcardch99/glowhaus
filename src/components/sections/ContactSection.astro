---
import Arrow from '../ui/Arrow.astro'
import Button from '../ui/Button.astro'
import { site } from '../../data/site'
import { treatments } from '../../data/treatments'
import { useT, type Lang } from '../../i18n'

// Sección «Tu cita empieza aquí»: formulario (EmailJS) + dirección, horario y mapa.
interface Props {
  lang: Lang
  /** En la página de Contacto ocupa al menos la pantalla y hace de cabecera */
  standalone?: boolean
  id?: string
}
const { lang, standalone = false, id = 'contacto' } = Astro.props
const t = useT(lang)
const motives = ['Consulta inicial', 'Reserva de cita', 'Tratamiento específico', 'Seguimiento']
const field =
  'cf-input text-cream placeholder:text-cream/45 block w-full rounded-none border-0 border-b border-[rgb(250_248_245/0.35)] bg-transparent py-2.5 text-[clamp(17px,calc(12px+0.8vw),20px)] outline-none focus-visible:outline-none'
const Heading = standalone ? 'h1' : 'h2'
---

<section
  id={id}
  data-theme="dark"
  class="bg-brown text-cream relative z-[11] min-h-screen scroll-mt-[90px] overflow-hidden"
>
  <div class="pointer-events-none absolute inset-0 bg-[rgb(24_18_14/0.74)]"></div>
  <div class="relative flex w-full flex-col gap-[clamp(32px,5vh,56px)] px-gutter pt-[clamp(110px,14vh,140px)] pb-[clamp(48px,7vh,80px)]">
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] items-end gap-x-16 gap-y-5">
      <div class="flex flex-col gap-[18px]">
        <span data-reveal class="eyebrow text-tan">
          {t('CONTACTO')}
        </span>
        <Heading
          data-words
          data-wdelay="80"
          class="font-display m-0 text-[clamp(34px,4.4vw,60px)] leading-[1.05] text-balance"
        >
          {t('Tu cita empieza aquí')}
        </Heading>
      </div>
      <p
        data-reveal="solo"
        data-delay="350"
        class="text-body text-cream-3 m-0 max-w-[440px] justify-self-end"
      >
        {t('Déjanos tus datos y te contactamos, o visítanos en la clínica.')}
      </p>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] items-stretch gap-4">
      <form
        data-contact-form
        data-reveal
        data-lang={lang}
        data-msg-name={t('Escribe tu nombre.')}
        data-msg-contact={t('Déjanos un teléfono o un correo para contactarte.')}
        data-msg-email={t('Revisa el correo: parece incompleto.')}
        data-msg-error={t(
          'No pudimos enviar el mensaje. Escríbenos por WhatsApp o llámanos al (786) 918-2997.',
        )}
        data-msg-sending={t('Enviando…')}
        novalidate
        class="glass-panel flex flex-col gap-6 self-stretch p-[clamp(28px,3.4vw,48px)]"
      >
        <div class="flex flex-col gap-2.5">
          <span class="eyebrow text-beige">{t('ESCRÍBENOS')}</span>
          <h3 class="text-gold m-0 text-[clamp(24px,2.4vw,34px)] leading-[1.1] font-semibold">
            {t('Te contactamos para agendar')}
          </h3>
        </div>

        <p
          data-form-sent
          hidden
          tabindex="-1"
          class="text-body-sm text-cream-2 m-0 flex items-start gap-3 outline-none"
          role="status"
        >
          <svg
            viewBox="0 0 24 24"
            width="22"
            height="22"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
            class="text-gold mt-0.5 flex-none"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <path class="cf-check" pathLength="1" d="m7.5 12.5 3 3 6-6.5"></path>
          </svg>
          <span>{t('Gracias. Te escribiremos pronto para confirmar tu cita.')}</span>
        </p>

        <div data-form-fields class="flex flex-col gap-6">
          <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,200px),1fr))] gap-x-7 gap-y-[22px]">
            <label class="cf-field flex flex-col gap-2">
              <span class="cf-label label-caps text-beige">{t('NOMBRE')}</span>
              <span class="relative block">
                <input
                  name="name"
                  type="text"
                  autocomplete="name"
                  required
                  placeholder={t('Tu nombre')}
                  class={field}
                />
                <span class="cf-line" aria-hidden="true"></span>
              </span>
            </label>
            <label class="cf-field flex flex-col gap-2">
              <span class="cf-label label-caps text-beige">{t('TELÉFONO')}</span>
              <span class="relative block">
                <input
                  name="phone"
                  type="tel"
                  autocomplete="tel"
                  inputmode="tel"
                  placeholder="(786) 000-0000"
                  class={field}
                />
                <span class="cf-line" aria-hidden="true"></span>
              </span>
            </label>
            <label class="cf-field flex flex-col gap-2">
              <span class="cf-label label-caps text-beige">{t('CORREO')}</span>
              <span class="relative block">
                <input
                  name="email"
                  type="email"
                  autocomplete="email"
                  placeholder={t('tu@correo.com')}
                  class={field}
                />
                <span class="cf-line" aria-hidden="true"></span>
              </span>
            </label>
            <label class="cf-field flex flex-col gap-2">
              <span class="cf-label label-caps text-beige">{t('MOTIVO DE CONTACTO')}</span>
              <span class="relative block">
                <select name="reason" data-reason class:list={[field, 'cf-select pr-8']}>
                  {motives.map((m) => (
                    <option value={t(m)} class="text-ink">
                      {t(m)}
                    </option>
                  ))}
                </select>
                <svg class="cf-chev" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="m5 8 5 5 5-5"></path>
                </svg>
                <span class="cf-line" aria-hidden="true"></span>
              </span>
            </label>
            <label data-treatment-field hidden class="cf-field col-span-full flex flex-col gap-2">
              <span class="cf-label label-caps text-beige">{t('¿QUÉ TRATAMIENTO?')}</span>
              <span class="relative block">
                <select name="treatment" class:list={[field, 'cf-select pr-8']}>
                  {treatments.map((c) => (
                    <option value={t(c.name)} class="text-ink">
                      {t(c.name)}
                    </option>
                  ))}
                </select>
                <svg class="cf-chev" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="m5 8 5 5 5-5"></path>
                </svg>
                <span class="cf-line" aria-hidden="true"></span>
              </span>
            </label>
          </div>
          <label class="cf-field flex flex-col gap-2">
            <span class="cf-label label-caps text-beige">{t('MENSAJE')}</span>
            <span class="relative block">
              <textarea
                name="message"
                rows="3"
                placeholder={t('Cuéntanos qué te gustaría mejorar')}
                class:list={[field, 'resize-y leading-normal']}
              ></textarea>
              <span class="cf-line" aria-hidden="true"></span>
            </span>
          </label>
          <!-- Trampa para bots: un humano no la ve ni la rellena -->
          <label class="sr-only" aria-hidden="true">
            Website
            <input name="website" type="text" tabindex="-1" autocomplete="off" />
          </label>
          <p
            data-form-error
            hidden
            role="alert"
            class="cf-error text-gold-light m-0 text-[15px]"
          ></p>
          <Button type="submit" class="cf-submit mt-1 min-w-[min(100%,200px)] self-start">
            {t('Enviar')}
          </Button>
        </div>
      </form>

      <div data-reveal class="flex min-w-0 flex-col gap-4">
        <div class="glass-panel px-[clamp(24px,2.6vw,36px)] pt-[clamp(24px,2.6vw,36px)] pb-2">
          <dl class="mt-2">
            <div class="grid grid-cols-[110px_minmax(0,1fr)] gap-4 border-b border-[rgb(250_248_245/0.14)] py-4">
              <dt class="label-caps text-tan pt-[3px]">{t('DIRECCIÓN')}</dt>
              <dd class="text-body-sm text-cream-2 m-0">
                11890 SW 8th St, Suite 211
                <br />
                Miami, FL 33184
              </dd>
            </div>
            <div class="grid grid-cols-[110px_minmax(0,1fr)] gap-4 border-b border-[rgb(250_248_245/0.14)] py-4">
              <dt class="label-caps text-tan pt-[3px]">{t('HORARIO')}</dt>
              <dd class="text-body-sm text-cream-2 m-0">
                {t('Lunes a viernes')}
                <br />
                {t('9:00 a. m. a 6:00 p. m.')}
              </dd>
            </div>
            <div class="grid grid-cols-[110px_minmax(0,1fr)] gap-4 py-4">
              <dt class="label-caps text-tan pt-[3px]">{t('CÓMO LLEGAR')}</dt>
              <dd class="m-0">
                <a
                  href={site.mapsLink}
                  target="_blank"
                  rel="noopener"
                  class="btn-glass max-w-full !whitespace-normal"
                >
                  <span>{t('Abrir en Google Maps')}</span>
                  <Arrow />
                </a>
              </dd>
            </div>
          </dl>
        </div>
        <!-- El mapa de Google se carga al pedirlo, para no frenar la página -->
        <div
          data-map
          class="bg-brown-2 relative min-h-[260px] flex-1 overflow-hidden rounded-[14px] border border-[rgb(250_248_245/0.55)]"
        >
          <button
            type="button"
            data-map-load
            data-src={site.mapsEmbed}
            data-title={t('Mapa de GlowHaus Aesthetics')}
            data-loading={t('Cargando mapa…')}
            class="map-btn text-cream absolute inset-0 z-[1] flex flex-col items-center justify-center gap-3"
          >
            <span class="map-pin relative grid size-16 place-items-center rounded-full">
              <svg
                width="34"
                height="34"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                aria-hidden="true"
              >
                <path d="M12 21s-7-6.1-7-11.5A7 7 0 0 1 19 9.5C19 14.9 12 21 12 21z"></path>
                <circle cx="12" cy="9.5" r="2.5"></circle>
              </svg>
            </span>
            <span data-map-label class="label-caps">
              {t('Ver mapa')}
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Campos: línea dorada que crece desde la izquierda al enfocar */
  .cf-line {
    position: absolute;
    inset: auto 0 0;
    height: 1.5px;
    background: var(--color-gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.55s var(--ease-glow);
    pointer-events: none;
  }
  .cf-field:focus-within .cf-line {
    transform: scaleX(1);
  }
  .cf-label {
    transition: color 0.35s;
  }
  .cf-field:focus-within .cf-label {
    color: var(--color-gold-light);
  }
  .cf-input {
    transition: border-color 0.35s;
  }
  @media (hover: hover) {
    .cf-input:hover {
      border-color: rgb(250 248 245 / 0.6);
    }
  }
  .cf-select {
    appearance: none;
    cursor: pointer;
  }
  .cf-chev {
    position: absolute;
    right: 2px;
    top: 50%;
    width: 18px;
    height: 18px;
    margin-top: -9px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    color: var(--color-beige);
    pointer-events: none;
    transition:
      transform 0.35s var(--ease-glow),
      color 0.35s;
  }
  .cf-field:focus-within .cf-chev {
    color: var(--color-gold-light);
    transform: translateY(2px);
  }

  /* Botón de envío: anillo que gira mientras se envía */
  :global(.cf-submit) {
    position: relative;
    transition:
      background 0.3s,
      color 0.3s,
      border-color 0.3s,
      opacity 0.3s;
  }
  :global(.cf-submit)::after {
    content: '';
    width: 1.1em;
    height: 1.1em;
    border: 1.5px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    display: none;
    animation: cf-spin 0.8s linear infinite;
  }
  :global(form[data-state='sending'] .cf-submit) {
    cursor: progress;
    opacity: 0.85;
  }
  :global(form[data-state='sending'] .cf-submit svg) {
    display: none;
  }
  :global(form[data-state='sending'] .cf-submit)::after {
    display: block;
  }
  @keyframes cf-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Mensajes: aparecen con un fundido suave, sin sacudidas */
  .cf-error:not([hidden]) {
    animation: cf-in 0.45s var(--ease-glow) both;
  }
  @keyframes cf-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .cf-check {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  :global(form[data-state='sent']) .cf-check {
    animation: cf-draw 0.7s 0.35s var(--ease-glow) both;
  }
  @keyframes cf-draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  /* Mapa: el botón invita (anillo que respira al pasar) y el mapa entra fundido */
  .map-btn {
    background: radial-gradient(circle at 50% 46%, rgb(168 132 79 / 0.16), transparent 60%);
    transition:
      color 0.35s,
      opacity 0.6s var(--ease-glow);
  }
  .map-pin {
    border: 1px solid rgb(250 248 245 / 0.25);
    transition:
      transform 0.5s var(--ease-glow),
      border-color 0.35s,
      background 0.35s;
  }
  .map-pin::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 50%;
    border: 1px solid var(--color-gold);
    opacity: 0;
  }
  @media (hover: hover) {
    .map-btn:hover {
      color: var(--color-gold-light);
    }
    .map-btn:hover .map-pin {
      transform: translateY(-4px);
      border-color: var(--color-gold);
      background: rgb(168 132 79 / 0.14);
    }
    .map-btn:hover .map-pin::after {
      animation: map-ring 1.6s var(--ease-glow) infinite;
    }
  }
  .map-btn:focus-visible .map-pin {
    border-color: var(--color-gold);
  }
  .map-btn[aria-busy='true'] {
    cursor: progress;
  }
  .map-btn[aria-busy='true'] .map-pin::after {
    animation: map-ring 1.2s var(--ease-glow) infinite;
  }
  @keyframes map-ring {
    from {
      transform: scale(1);
      opacity: 0.7;
    }
    to {
      transform: scale(1.7);
      opacity: 0;
    }
  }
  :global(.map-frame) {
    opacity: 0;
    transition: opacity 0.9s var(--ease-glow);
  }
  :global(.map-frame[data-loaded]) {
    opacity: 1;
  }
</style>

<script>
  import { gsap, prefersReducedMotion } from '../../scripts/gsap'
  import { sendContact } from '../../scripts/contact'

  const reduce = prefersReducedMotion()

  // Formulario: muestra «¿Qué tratamiento?» si hace falta y envía con EmailJS
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const reason = form.querySelector<HTMLSelectElement>('[data-reason]')
    const txField = form.querySelector<HTMLElement>('[data-treatment-field]')
    reason?.addEventListener('change', () => {
      if (!txField) return
      const show = reason.selectedIndex === 2
      if (show === !txField.hidden) return
      txField.hidden = !show
      if (show && !reduce)
        gsap.from(txField, { opacity: 0, y: -10, duration: 0.5, ease: 'glow', clearProps: 'all' })
    })
    form.addEventListener('submit', (e) => {
      e.preventDefault()
      void sendContact(form)
    })

    // Enviado: los campos se pliegan con suavidad y entra el agradecimiento
    form.addEventListener('gh:contact-sent', (e) => {
      const fields = form.querySelector<HTMLElement>('[data-form-fields]')
      const sent = form.querySelector<HTMLElement>('[data-form-sent]')
      if (!fields || !sent || reduce) return
      e.preventDefault()
      gsap
        .timeline({
          onComplete: () => {
            fields.hidden = true
            gsap.set(fields, { clearProps: 'all' })
          },
        })
        .to(fields, { opacity: 0, y: -12, duration: 0.35, ease: 'power2.in' })
        .to(fields, { height: 0, marginTop: -24, duration: 0.6, ease: 'swift' })
        .add(() => {
          sent.hidden = false
          sent.focus({ preventScroll: true })
        })
        .from(sent, { opacity: 0, y: 18, duration: 0.8, ease: 'glow', clearProps: 'all' })
    })
  })

  // Mapa bajo demanda: se carga detrás del botón y entra fundido al estar listo
  document.querySelectorAll<HTMLButtonElement>('[data-map-load]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (btn.getAttribute('aria-busy') === 'true') return
      btn.setAttribute('aria-busy', 'true')
      const label = btn.querySelector('[data-map-label]')
      if (label && btn.dataset.loading) label.textContent = btn.dataset.loading
      const frame = document.createElement('iframe')
      frame.src = btn.dataset.src ?? ''
      frame.title = btn.dataset.title ?? ''
      frame.referrerPolicy = 'no-referrer-when-downgrade'
      frame.className =
        'map-frame absolute inset-0 block size-full border-0 [filter:sepia(.25)_saturate(.8)]'
      const finish = () => {
        frame.setAttribute('data-loaded', '')
        btn.style.opacity = '0'
        btn.style.pointerEvents = 'none'
        window.setTimeout(() => btn.remove(), reduce ? 0 : 650)
      }
      frame.addEventListener('load', finish, { once: true })
      // Por si el evento no llega (bloqueadores): se muestra igual a los 6 s
      window.setTimeout(() => {
        if (!frame.hasAttribute('data-loaded')) finish()
      }, 6000)
      btn.before(frame)
    })
  })
</script>
