---
import { Image } from 'astro:assets'
import Button from '../ui/Button.astro'
import isotipo from '../../assets/glowhaus-isotipo-crema.jpg'
import b1 from '../../assets/about/b1.jpg'
import b2 from '../../assets/about/b2.jpg'
import b3 from '../../assets/about/b3.jpg'
import b4 from '../../assets/about/b4.jpg'
import { pathFor, useT, type Lang } from '../../i18n'

// «Una casa moderna de estética»: texto y galería de cuatro fotos. La foto grande
// cambia cada 4 s con un fundido y un leve acercamiento; la miniatura activa
// muestra el avance en una barra dorada. Se para con el ratón encima, el foco
// dentro, fuera de pantalla o con la pestaña oculta, y 6 s tras elegir una foto.
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useT(lang)

const photos = [
  { src: b1, pos: '50% 25%' },
  { src: b2, pos: '50% 55%' },
  { src: b3, pos: '50% 40%' },
  { src: b4, pos: '50% 30%' },
]
---

<section
  id="nosotros"
  data-theme="light"
  class="bg-sand stack-shadow px-gutter relative z-[1] grid min-h-[calc(100vh+40px)] grid-cols-[repeat(auto-fit,minmax(min(100%,440px),1fr))] items-center gap-[clamp(40px,6vw,96px)] pt-[clamp(64px,10vh,120px)] pb-[clamp(96px,14vh,150px)]"
>
  <div class="flex max-w-[640px] flex-col gap-7">
    <h2
      data-reveal
      class="font-display text-brown m-0 text-[clamp(30px,3.4vw,54px)] leading-[1.06]"
    >
      <span class="inline-block">{t('Una casa moderna')}</span>
      <br />
      <span class="inline-block">{t('de estética')}</span>
    </h2>
    <p data-reveal class="text-body text-ink m-0 max-w-[688px] !leading-[1.7] text-pretty">
      {t(
        'Fundado por Alain Castellat, APRN, FNP-C, GlowHaus no es un medspa tradicional. Es un espacio boutique en Miami, pequeño, íntimo y cuidado, donde atendemos a una sola persona a la vez. Sin volumen, sin esperas y sin mirar el reloj.',
      )}
    </p>
    <p data-reveal class="text-body text-ink m-0 max-w-[713px] !leading-[1.7] text-pretty">
      {t(
        'Nació de una idea clara: la estética no debería ser rápida. Debería ser una experiencia, con la atención enfocada solamente en ti.',
      )}
    </p>
    <div data-reveal class="mt-1">
      <Button href={pathFor(lang, 'about')} tone="dark" class="min-w-[min(100%,200px)]">
        {t('Ver más')}
      </Button>
    </div>
  </div>

  <div
    data-about-gal
    class="flex w-[calc(4*clamp(84px,8vw,120px)+54px)] max-w-full min-w-0 flex-col gap-[clamp(24px,4vh,40px)] justify-self-center"
  >
    <div data-reveal class="bg-sand relative aspect-square w-full overflow-hidden rounded-[14px]">
      {photos.map((p, i) => (
        <Image
          src={p.src}
          alt={i === 0 ? t('Interior de GlowHaus Aesthetics en Miami') : ''}
          data-about-img={i}
          widths={[420, 640, 900]}
          sizes="(min-width: 760px) 534px, 100vw"
          style={`object-position:${p.pos}`}
          data-on={i === 0 ? '' : undefined}
          class="about-img absolute inset-0 size-full object-cover"
        />
      ))}
      <div class="glass-chip pointer-events-none absolute bottom-3 left-3 flex max-w-[calc(100%-24px)] items-center gap-2.5 rounded-xl py-2 pr-3.5 pl-2">
        <Image
          src={isotipo}
          alt=""
          width={84}
          class="size-[clamp(32px,2.6vw,42px)] flex-none rounded-lg object-cover"
        />
        <div class="flex min-w-0 flex-col gap-px">
          <span class="text-cream text-[clamp(15px,calc(10px+0.8vw),21.5px)] leading-[1.2] font-semibold">
            GlowHaus Aesthetics
          </span>
          <span class="text-sand-2 text-[clamp(13.5px,calc(9px+0.6vw),17px)] leading-[1.35]">
            {t('Boutique spa · Miami')}
          </span>
        </div>
      </div>
    </div>

    <div
      data-reveal
      class="flex justify-between gap-[18px]"
      role="group"
      aria-label={t('Fotos de GlowHaus')}
    >
      {photos.map((p, i) => (
        <button
          type="button"
          data-about-thumb={i}
          aria-pressed={i === 0 ? 'true' : 'false'}
          aria-label={`${t('Foto')} ${i + 1}`}
          class="group relative isolate aspect-[5/6] w-[clamp(64px,8vw,120px)] flex-none opacity-60 transition-[opacity,transform] duration-300 ease-(--ease-glow) hover:-translate-y-1.5 hover:scale-[1.04] hover:opacity-100 aria-pressed:opacity-100"
        >
          <Image
            src={p.src}
            alt=""
            widths={[120, 240]}
            sizes="120px"
            class="absolute inset-0 -z-10 size-full rounded-[14px] object-cover object-[center_25%]"
          />
          <span
            aria-hidden="true"
            class="group-aria-pressed:border-gold pointer-events-none absolute inset-y-0 -inset-x-1.5 rounded-[18px] border-x-2 border-transparent transition-colors duration-400"
          />
          <span
            aria-hidden="true"
            class="about-track pointer-events-none absolute inset-x-2.5 bottom-2 h-0.5 overflow-hidden rounded-full bg-[rgb(250_248_245/0.35)] opacity-0 transition-opacity duration-300"
          >
            <span data-about-bar class="about-bar bg-gold block h-full w-full"></span>
          </span>
        </button>
      ))}
    </div>
  </div>
</section>

<style>
  .about-img {
    opacity: 0;
    transform: scale(1.08);
    transition:
      opacity 1.1s ease,
      transform 0s linear 1.1s;
  }
  .about-img[data-on] {
    opacity: 1;
    transform: scale(1);
    transition:
      opacity 1.1s ease,
      transform 5.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  :global(html:not(.js)) .about-img[data-on] {
    transform: none;
  }
  /* Barra de avance de la miniatura activa (solo mientras rota) */
  [data-rotating] [aria-pressed='true'] .about-track {
    opacity: 1;
  }
  .about-bar {
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  [data-rotating] [aria-pressed='true'] .about-bar {
    animation: about-fill 4s linear both;
  }
  [data-rotating][data-paused] .about-bar {
    animation-play-state: paused;
  }
  @keyframes about-fill {
    to {
      transform: scaleX(1);
    }
  }
</style>

<script>
  import { prefersReducedMotion } from '../../scripts/gsap'

  const gal = document.querySelector<HTMLElement>('[data-about-gal]')
  if (gal) {
    const imgs = gal.querySelectorAll<HTMLElement>('[data-about-img]')
    const thumbs = gal.querySelectorAll<HTMLButtonElement>('[data-about-thumb]')
    let idx = 0
    const show = (i: number) => {
      idx = i
      imgs.forEach((im, k) => im.toggleAttribute('data-on', k === i))
      thumbs.forEach((b, k) => b.setAttribute('aria-pressed', String(k === i)))
    }

    if (prefersReducedMotion()) {
      thumbs.forEach((b, i) => b.addEventListener('click', () => show(i)))
    } else {
      // El reloj es la propia barra: al terminar su animación de 4 s pasa a la
      // siguiente foto. Pausar la barra pausa la rotación.
      gal.setAttribute('data-rotating', '')
      const holds = { hover: false, focus: false, offscreen: true, hidden: document.hidden }
      let holdUntil = 0
      let holdT = 0
      const sync = () => {
        const paused =
          holds.hover || holds.focus || holds.offscreen || holds.hidden || Date.now() < holdUntil
        gal.toggleAttribute('data-paused', paused)
      }
      const restartBar = () => {
        const bar = thumbs[idx]?.querySelector<HTMLElement>('[data-about-bar]')
        if (!bar) return
        bar.style.animation = 'none'
        void bar.offsetWidth
        bar.style.animation = ''
      }
      gal.addEventListener('animationend', (e) => {
        if (!(e.target as Element).hasAttribute('data-about-bar')) return
        show((idx + 1) % imgs.length)
      })
      thumbs.forEach((b, i) =>
        b.addEventListener('click', () => {
          show(i)
          restartBar()
          holdUntil = Date.now() + 6000
          window.clearTimeout(holdT)
          holdT = window.setTimeout(sync, 6000)
          sync()
        }),
      )
      gal.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') {
          holds.hover = true
          sync()
        }
      })
      gal.addEventListener('pointerleave', () => {
        holds.hover = false
        sync()
      })
      gal.addEventListener('focusin', () => {
        holds.focus = true
        sync()
      })
      gal.addEventListener('focusout', () => {
        holds.focus = false
        sync()
      })
      document.addEventListener('visibilitychange', () => {
        holds.hidden = document.hidden
        sync()
      })
      new IntersectionObserver(([en]) => {
        holds.offscreen = !en?.isIntersecting
        sync()
      }).observe(gal)
      sync()
    }
  }
</script>
