---
import { Image } from 'astro:assets'
import Button from '../ui/Button.astro'
import PauseButton from './PauseButton.astro'
import isotipo from '../../assets/glowhaus-isotipo-crema.jpg'
import { treatments } from '../../data/treatments'
import { treatmentPath, useT, type Lang } from '../../i18n'

// Fotona 4D, la tecnología insignia: vídeo enmarcado sobre su copia difuminada
// (una imagen fija, que pesa menos que un segundo vídeo) y precios con contador.
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useT(lang)
const fotona = treatments[0]!
---

<section
  data-theme="dark"
  class="bg-brown text-cream relative z-[4] flex min-h-[calc(100vh+120px)] items-center overflow-hidden"
>
  <img
    src="/media/fotona-reel.jpg"
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    class="pointer-events-none absolute inset-0 size-full scale-[1.2] object-cover blur-[38px] saturate-[1.1]"
  />
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgb(24_18_14/0.55),rgb(24_18_14/0.4)_50%,rgb(24_18_14/0.6))]"></div>

  <div class="px-gutter relative grid w-full grid-cols-[repeat(auto-fit,minmax(min(100%,440px),1fr))] items-center gap-[clamp(32px,5vw,80px)] pt-[clamp(130px,17vh,170px)] pb-[clamp(48px,7vh,96px)]">
    <div class="bg-brown-2 relative aspect-[3/4] h-[min(76vh,760px)] max-w-full justify-self-center overflow-hidden rounded-[14px] max-md:h-auto max-md:w-full max-md:aspect-[4/5]">
      <video
        id="fotona-video"
        data-autoplay
        data-src="/media/fotona-reel.mp4"
        poster="/media/fotona-reel.jpg"
        muted
        loop
        playsinline
        preload="none"
        aria-label={t('Tratamiento con láser Fotona 4D')}
        class="block size-full object-cover"
      ></video>
      <div class="glass-chip pointer-events-none absolute bottom-3 left-3 flex max-w-[calc(100%-80px)] items-center gap-2.5 rounded-xl py-2 pr-3.5 pl-2">
        <Image
          src={isotipo}
          alt=""
          width={84}
          class="size-[clamp(32px,2.6vw,42px)] flex-none rounded-lg object-cover"
        />
        <div class="flex min-w-0 flex-col gap-px">
          <span class="text-[clamp(15px,calc(10px+0.8vw),21.5px)] leading-[1.2] font-semibold">
            Fotona 4D
          </span>
          <span class="text-sand-2 text-[clamp(13.5px,calc(9px+0.6vw),17px)] leading-[1.35]">
            {t('Tecnología insignia de GlowHaus')}
          </span>
        </div>
      </div>
      <PauseButton lang={lang} controls="fotona-video" class="absolute right-3 bottom-3" />
    </div>

    <div class="flex flex-col gap-[22px]">
      <span class="eyebrow text-tan">{t('TECNOLOGÍA INSIGNIA')}</span>
      <h2 data-reveal class="font-display m-0 text-[clamp(34px,4.4vw,58px)] leading-[1.05]">
        Fotona 4D
      </h2>
      <p data-reveal data-delay="200" class="text-body text-cream-3 m-0 max-w-[520px]">
        {t(
          'Un tratamiento láser que trabaja el rostro por dentro y por fuera, en cuatro pasos y en una sola sesión. Sin agujas y sin cirugía.',
        )}
      </p>
      <dl class="m-0 grid grid-flow-col grid-cols-[repeat(3,auto)] grid-rows-[auto_auto] justify-start gap-x-[clamp(18px,3vw,40px)] gap-y-2 py-5">
        {[
          { k: 'SESIÓN', v: '$650', n: 650 },
          { k: 'PAQUETE DE 4', v: '$2,400', n: 2400 },
          { k: 'RECUPERACIÓN', v: 'Mínima' },
        ].map((r) => (
          <div class="contents">
            <dt class="text-tan text-[clamp(11px,calc(8px+0.7vw),13.5px)] font-medium tracking-[0.1em]">
              {t(r.k)}
            </dt>
            <dd
              class="m-0 text-[clamp(19px,calc(14px+1vw),24px)] font-semibold tabular-nums"
              data-count={r.n}
            >
              {r.n ? r.v : t(r.v)}
            </dd>
          </div>
        ))}
      </dl>
      <div data-reveal data-delay="400">
        <Button href={treatmentPath(lang, fotona.slug[lang])} class="min-w-[min(100%,200px)]">
          {t('Conoce Fotona 4D')}
        </Button>
      </div>
    </div>
  </div>
</section>
