---
import { Image } from 'astro:assets'
import Button from '../ui/Button.astro'
import isotipo from '../../assets/glowhaus-isotipo-crema.jpg'
import { treatments } from '../../data/treatments'
import { treatmentPath, useT, type Lang } from '../../i18n'

// Fotona 4D, la tecnología insignia: vídeo enmarcado sobre el mismo vídeo
// difuminado de fondo (como el diseño) y precios con contador.
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useT(lang)
const fotona = treatments[0]!
---

<section
  data-theme="dark"
  class="bg-brown text-cream relative z-[4] flex min-h-[calc(100vh+120px)] items-center overflow-hidden"
>
  <video
    data-autoplay
    data-src="/media/fotona-reel.mp4"
    poster="/media/fotona-reel.jpg"
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    tabindex="-1"
    class="pointer-events-none absolute inset-0 size-full scale-[1.2] object-cover blur-[38px] saturate-[1.1]"
  ></video>
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgb(24_18_14/0.55),rgb(24_18_14/0.4)_50%,rgb(24_18_14/0.6))]"></div>

  <div class="px-gutter relative grid w-full grid-cols-[repeat(auto-fit,minmax(min(100%,440px),1fr))] items-center gap-[clamp(32px,5vw,80px)] pt-[clamp(80px,11vh,110px)] pb-[clamp(48px,7vh,96px)]">
    <div
      data-fotona-frame
      class="bg-brown-2 relative aspect-[4/4.2] h-[calc(100vh-2*clamp(48px,7vh,96px)-30px)] min-h-[380px] max-w-full justify-self-center overflow-hidden rounded-[14px] max-[759px]:aspect-[4/5] max-[759px]:h-auto max-[759px]:min-h-0 max-[759px]:w-full"
    >
      <video
        id="fotona-video"
        data-autoplay
        data-src="/media/fotona-reel.mp4"
        poster="/media/fotona-reel.jpg"
        muted
        loop
        playsinline
        preload="none"
        aria-label={t('Tratamiento con láser Fotona 4D')}
        class="block size-full object-cover"
        data-fotona-video
      ></video>
      <div class="glass-chip pointer-events-none absolute bottom-3 left-3 flex max-w-[calc(100%-24px)] items-center gap-2.5 rounded-xl py-2 pr-3.5 pl-2">
        <Image
          src={isotipo}
          alt=""
          width={84}
          class="size-[clamp(32px,2.6vw,42px)] flex-none rounded-lg object-cover"
        />
        <div class="flex min-w-0 flex-col gap-px">
          <span class="text-[clamp(15px,calc(10px+0.8vw),21.5px)] leading-[1.2] font-semibold">
            Fotona 4D
          </span>
          <span class="text-sand-2 text-[clamp(13.5px,calc(9px+0.6vw),17px)] leading-[1.35]">
            {t('Tecnología insignia de GlowHaus')}
          </span>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-[22px]">
      <span data-reveal class="eyebrow text-tan">
        {t('TECNOLOGÍA INSIGNIA')}
      </span>
      <h2 data-reveal class="font-display m-0 text-[clamp(34px,4.4vw,58px)] leading-[1.05]">
        Fotona 4D
      </h2>
      <p data-reveal class="text-body text-cream-3 m-0 max-w-[520px]">
        {t(
          'Un tratamiento láser que trabaja el rostro por dentro y por fuera, en cuatro pasos y en una sola sesión. Sin agujas y sin cirugía.',
        )}
      </p>
      <dl
        data-reveal
        class="m-0 grid grid-flow-col grid-cols-[repeat(3,auto)] grid-rows-[auto_auto] justify-start gap-x-[clamp(18px,3vw,40px)] gap-y-2 py-5"
      >
        {[
          { k: 'SESIÓN', v: '$650', n: 650 },
          { k: 'PAQUETE DE 4', v: '$2,400', n: 2400 },
          { k: 'RECUPERACIÓN', v: 'Mínima' },
        ].map((r) => (
          <div class="contents">
            <dt class="text-tan text-[clamp(11px,calc(8px+0.7vw),13.5px)] font-medium tracking-[0.1em]">
              {t(r.k)}
            </dt>
            <dd
              class="m-0 text-[clamp(19px,calc(14px+1vw),24px)] font-semibold tabular-nums"
              data-count={r.n}
            >
              {r.n ? r.v : t(r.v)}
            </dd>
          </div>
        ))}
      </dl>
      <div data-reveal>
        <Button
          href={treatmentPath(lang, fotona.slug[lang])}
          data-glow
          class="min-w-[min(100%,200px)]"
        >
          {t('Conoce Fotona 4D')}
        </Button>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion } from '../../scripts/gsap'

  // El vídeo enmarcado se abre desde el centro y el plano se asienta (1,4 s)
  const frame = document.querySelector<HTMLElement>('[data-fotona-frame]')
  const video = frame?.querySelector<HTMLElement>('[data-fotona-video]')
  if (frame && video && !prefersReducedMotion()) {
    gsap
      .timeline({ scrollTrigger: { trigger: frame, start: 'top 82%', once: true } })
      .fromTo(
        frame,
        { clipPath: 'inset(14% 10% 14% 10% round 14px)' },
        {
          clipPath: 'inset(0% 0% 0% 0% round 14px)',
          duration: 1.4,
          ease: 'wipe',
          clearProps: 'clipPath',
        },
      )
      .fromTo(
        video,
        { scale: 1.18 },
        { scale: 1, duration: 1.8, ease: 'glow', clearProps: 'transform' },
        0,
      )
  }
</script>
