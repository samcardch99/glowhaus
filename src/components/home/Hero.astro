---
import Button from '../ui/Button.astro'
import Arrow from '../ui/Arrow.astro'
import PauseButton from './PauseButton.astro'
import { site, whatsappHref } from '../../data/site'
import { pathFor, useT, type Lang } from '../../i18n'

// Primera pantalla: reel vertical enmarcado a la derecha sobre una copia
// difuminada (en móvil, a pantalla completa). La sección es sticky y la
// siguiente la tapa (data-cover).
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useT(lang)

const stats = [
  {
    label: 'TRATAMIENTOS CON PRECIO',
    value: '80+',
    href: pathFor(lang, 'treatments'),
    aria: 'Ver tratamientos',
  },
  {
    label: 'RESEÑAS EN GOOGLE',
    value: '5.0 ★',
    href: site.googleReviews,
    aria: 'Ver reseñas en Google',
    external: true,
  },
  { label: 'DIRECCIÓN MÉDICA', value: 'APRN', href: '#equipo', aria: 'Ver equipo' },
]
---

<section
  data-theme="overlay"
  data-cover
  class="bg-brown text-cream sticky top-0 z-0 flex h-svh min-h-[620px] flex-col overflow-hidden"
>
  <div data-cover-target class="absolute inset-0">
    <!-- Copia difuminada, solo en escritorio -->
    <video
      data-autoplay
      data-hero-bg
      data-src="/media/hero-reel.mp4"
      poster="/media/hero-reel.jpg"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"
      class="absolute -inset-10 hidden size-[calc(100%+80px)] max-w-none object-cover blur-[28px] brightness-70 md:block"
    ></video>
    <video
      id="hero-video"
      data-hero-corner
      data-autoplay
      data-src="/media/hero-reel.mp4"
      poster="/media/hero-reel.jpg"
      muted
      loop
      playsinline
      preload="none"
      aria-label={t('Vídeo de la clínica GlowHaus')}
      class="absolute inset-0 size-full object-cover object-[center_40%] md:right-0 md:left-auto md:w-[min(62vh,38vw)]"
    ></video>
    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgb(24_18_14/0.55)_0%,rgb(24_18_14/0.1)_30%,rgb(24_18_14/0.25)_55%,rgb(24_18_14/0.8)_100%)]"></div>
  </div>

  <div
    data-hero-copy
    class="px-gutter relative flex flex-1 flex-col justify-end pt-[clamp(120px,16vh,150px)] pb-[clamp(28px,6vh,64px)] md:pr-[calc(min(62vh,38vw)+48px)]"
  >
    <div class="flex flex-col gap-[18px]">
      <h1
        data-hero-h1
        class="font-display m-0 max-w-[12.8em] text-[clamp(30px,min(4.4vw,7.8vh),68px)] leading-none tracking-[0.01em] [text-wrap:wrap]"
      >
        {t('Resultados naturales, con un equipo que conoces')}
      </h1>
      <div class="flex flex-wrap items-end gap-x-8 gap-y-5">
        <p
          data-hero-in
          data-delay="200"
          class="text-body text-cream-2 m-0 max-w-[520px] text-pretty"
        >
          {t(
            'Láser Fotona, inyectables, rellenos, depilación láser y faciales médicos en Miami. Cada tratamiento empieza con una valoración y un plan pensado para tu piel.',
          )}
        </p>
        <div data-hero-in data-delay="320">
          <Button href={whatsappHref(lang)} external>
            {t('Reservar cita')}
          </Button>
        </div>
      </div>
      <ul
        role="list"
        class="m-0 mt-[clamp(8px,2.4vh,32px)] flex w-full max-w-full md:w-[calc(clamp(30px,min(4.4vw,7.8vh),68px)*12.07)] list-none gap-2 p-0 sm:gap-3"
      >
        {stats.map((s, i) => (
          <li
            data-hero-in
            data-delay={String(420 + i * 160)}
            class="relative flex min-w-0 flex-1 flex-col gap-2 rounded-[14px] border border-[rgb(250_248_245/0.18)] bg-[rgb(250_248_245/0.08)] px-[clamp(10px,1.6vw,22px)] py-[clamp(12px,1.4vw,18px)]"
          >
            <span class="text-sand text-[clamp(9.5px,0.9vw,13px)] leading-[1.4] font-medium tracking-[0.1em]">
              {t(s.label)}
            </span>
            <span class="text-[clamp(20px,2.4vw,34px)] leading-none font-semibold">{s.value}</span>
            <a
              href={s.href}
              aria-label={t(s.aria)}
              {...(s.external ? { target: '_blank', rel: 'noopener' } : {})}
              class="text-cream hover:text-gold absolute inset-0 flex items-center justify-center rounded-[14px] opacity-85 transition hover:opacity-100 md:inset-auto md:right-1 md:bottom-0.5 md:size-11 md:rounded-[10px]"
            >
              <Arrow class="max-md:hidden" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <PauseButton
    lang={lang}
    controls="hero-video"
    class="absolute top-[clamp(96px,14vh,120px)] right-4 z-10 md:top-auto md:right-6 md:bottom-6"
  />
</section>

<style>
  /* La primera pantalla entra con su propia coreografía (tras la entrada de marca) */
  :global(.js) [data-hero-in],
  :global(.js) [data-hero-h1] {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) [data-hero-in],
    :global(.js) [data-hero-h1] {
      opacity: 1;
    }
  }
</style>

<script>
  import { gsap, SplitText, prefersReducedMotion } from '../../scripts/gsap'

  // El fondo difuminado sigue al vídeo principal (pausa y reproducción)
  const main = document.getElementById('hero-video') as HTMLVideoElement | null
  const bg = document.querySelector<HTMLVideoElement>('[data-hero-bg]')
  if (main && bg) {
    main.addEventListener('pause', () => {
      if (main.dataset.userPaused) {
        bg.dataset.userPaused = '1'
        bg.pause()
      }
    })
    main.addEventListener('play', () => {
      delete bg.dataset.userPaused
      if (getComputedStyle(bg).display !== 'none') bg.play().catch(() => {})
    })
  }

  const h1 = document.querySelector<HTMLElement>('[data-hero-h1]')
  const items = gsap.utils.toArray<HTMLElement>('[data-hero-in]')
  const corner = document.querySelector<HTMLElement>('[data-hero-corner]')
  const copy = document.querySelector<HTMLElement>('[data-hero-copy]')

  function enter() {
    // Titular: cada línea sube desde su máscara y las palabras llegan escalonadas
    if (h1) {
      SplitText.create(h1, {
        type: 'lines,words',
        mask: 'lines',
        aria: 'auto',
        onSplit: (self) => {
          // La máscara no debe cortar las colas de las letras (Q, comas)
          self.masks.forEach((m) => {
            m.style.paddingBottom = '0.14em'
            m.style.marginBottom = '-0.14em'
          })
          gsap.set(h1, { opacity: 1 })
          return gsap.from(self.words, {
            yPercent: 115,
            rotate: 2.5,
            duration: 1.15,
            ease: 'power4.out',
            stagger: { each: 0.045, from: 'start' },
            delay: 0.05,
          })
        },
      })
    }
    // Texto, botón y cifras: los parámetros de aparición del diseño
    items.forEach((el) => {
      gsap.fromTo(
        el,
        { opacity: 0, y: 56, scale: 0.96 },
        {
          opacity: 1,
          y: 0,
          scale: 1,
          duration: 0.8,
          delay: 0.15 + Number(el.dataset.delay ?? 0) / 1000,
          ease: 'glow',
          clearProps: 'transform',
        },
      )
    })
    // El vídeo enmarcado se descubre de derecha a izquierda (solo cuando está enmarcado)
    if (corner && window.matchMedia('(min-width: 768px)').matches)
      corner.animate([{ clipPath: 'inset(0 0 0 100%)' }, { clipPath: 'inset(0 0 0 0)' }], {
        duration: 1100,
        delay: 250,
        easing: 'cubic-bezier(.7,0,.2,1)',
        fill: 'backwards',
      })
  }

  if (prefersReducedMotion()) {
    gsap.set([h1, ...items], { opacity: 1 })
  } else {
    let started = false
    const start = () => {
      if (started) return
      started = true
      void document.fonts.ready.then(enter)
    }
    if (document.documentElement.classList.contains('gh-intro-on')) {
      window.addEventListener('gh:intro-reveal', start, { once: true })
      window.addEventListener('gh:intro-done', start, { once: true })
    } else start()

    // Mientras «Nosotros» tapa la primera pantalla, el texto sube y se apaga
    // (el vídeo lo encoge y oscurece data-cover, en site.ts)
    const next = copy?.closest('section')?.nextElementSibling
    if (copy && next)
      gsap.to(copy, {
        yPercent: -14,
        opacity: 0.25,
        ease: 'none',
        scrollTrigger: { trigger: next, start: 'top bottom', end: 'top top', scrub: true },
      })
  }
</script>
