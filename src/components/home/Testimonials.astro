---
import { testimonials } from '../../data/home'
import { useT, type Lang } from '../../i18n'

// «En sus palabras»: testimonios en vídeo, como en el diseño. La tarjeta centrada
// se destaca y su vídeo se reproduce sin sonido mientras la pista se ve; al
// terminar pasa al siguiente. Pulsar una tarjeta la centra; la centrada tiene
// botones de pausa y de sonido. Se arrastra con inercia. Sin JS quedan los
// controles nativos de cada vídeo.
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useT(lang)
---

<div class="mt-[clamp(40px,6vh,72px)] flex flex-wrap items-baseline justify-between gap-x-12 gap-y-3">
  <h2 data-reveal class="font-display m-0 text-[clamp(28px,3.4vw,54px)] leading-[1.06]">
    {t('En sus palabras')}
  </h2>
  <p
    data-reveal
    data-delay="220"
    class="text-sand-2 m-0 text-[clamp(17px,1.4vw,21px)] leading-[1.45]"
  >
    {t('Pacientes de GlowHaus cuentan cómo vivieron su tratamiento.')}
  </p>
</div>

<div data-reveal="solo" data-delay="300" class="-mx-(--g) [--g:clamp(24px,1.8vw,28px)]">
  <ul
    role="list"
    data-testi-track
    aria-label={t('Testimonios en vídeo')}
    class="testi-track no-scrollbar m-0 flex list-none gap-5 overflow-x-auto px-(--g) pt-3 pb-6 select-none"
  >
    {testimonials.map((v, i) => (
      <li class="testi-card w-[clamp(270px,25vw,350px)] flex-none" data-testi={i}>
        <div class="bg-brown relative aspect-[4/5.4] overflow-hidden rounded-[20px]">
          <video
            src={v.src}
            poster={v.poster}
            preload="none"
            playsinline
            controls
            data-testi-video
            aria-label={`${t('Testimonio')}: ${t(v.title)} (${t(v.tag)})`}
            class="absolute inset-0 size-full object-cover"
          />
          <div class="testi-ui pointer-events-none absolute inset-0 hidden flex-col justify-between bg-[linear-gradient(180deg,rgb(24_18_14/0.25),transparent_30%,transparent_50%,rgb(24_18_14/0.55))] p-3 text-cream [.js_&]:flex">
            <div class="flex items-start justify-between gap-2">
              <span class="glass-chip flex min-w-0 gap-2.5 rounded-lg px-3 py-[7px] text-[15px] font-medium">
                <span class="whitespace-nowrap">{t('Testimonio')}</span>
                <span class="text-sand-2 min-w-0 truncate">{t(v.tag)}</span>
              </span>
              <button
                type="button"
                data-testi-sound
                aria-pressed="false"
                aria-label={t('Activar sonido')}
                data-on={t('Silenciar')}
                data-off={t('Activar sonido')}
                class="testi-ctl group glass-chip hover:bg-gold pointer-events-auto flex size-11 flex-none items-center justify-center rounded-full transition-[background-color,opacity] duration-300"
              >
                <svg
                  viewBox="0 0 20 20"
                  width="18"
                  height="18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M3 8v4h3l4 3.5v-11L6 8z" fill="currentColor" stroke="none" />
                  <path class="group-aria-pressed:hidden" d="m13 8 4 4m0-4-4 4" />
                  <path
                    class="hidden group-aria-pressed:block"
                    d="M13.5 7.5a3.5 3.5 0 0 1 0 5M15.5 5.5a6.5 6.5 0 0 1 0 9"
                  />
                </svg>
              </button>
            </div>
            <button
              type="button"
              data-testi-play
              aria-pressed="false"
              aria-label={`${t('Reproducir testimonio')}: ${t(v.title)}`}
              data-play={`${t('Reproducir testimonio')}: ${t(v.title)}`}
              data-pause={`${t('Pausar testimonio')}: ${t(v.title)}`}
              class="testi-play group glass-chip hover:bg-gold pointer-events-auto absolute top-1/2 left-1/2 flex size-16 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full transition-[background-color,opacity,transform] duration-300"
            >
              <svg
                viewBox="0 0 20 20"
                width="22"
                height="22"
                fill="currentColor"
                aria-hidden="true"
                class="group-aria-pressed:hidden"
              >
                <path d="M6 3.5v13l11-6.5z" />
              </svg>
              <svg
                viewBox="0 0 20 20"
                width="20"
                height="20"
                fill="currentColor"
                aria-hidden="true"
                class="hidden group-aria-pressed:block"
              >
                <rect x="4.5" y="3.5" width="3.5" height="13" rx="1" />
                <rect x="12" y="3.5" width="3.5" height="13" rx="1" />
              </svg>
            </button>
            <span class="glass-chip relative flex w-full flex-col gap-2 overflow-hidden rounded-lg px-4 pt-3.5 pb-4">
              <span class="text-[23.5px] leading-[1.15] font-semibold">{t(v.title)}</span>
              <span
                aria-hidden="true"
                class="absolute inset-x-0 bottom-0 h-0.5 bg-[rgb(250_248_245/0.15)]"
              >
                <span
                  data-testi-bar
                  class="bg-gold block h-full w-full origin-left scale-x-0"
                ></span>
              </span>
            </span>
          </div>
        </div>
      </li>
    ))}
  </ul>
</div>

<style>
  :global(.js) .testi-track {
    cursor: grab;
  }
  :global(.js) .testi-card {
    opacity: 0.55;
    transform: scale(0.97);
    transition:
      transform 0.6s var(--ease-glow),
      opacity 0.6s;
  }
  :global(.js) .testi-card[data-active] {
    opacity: 1;
    transform: translateY(-8px) scale(1.03);
  }
  /* Los botones de sonido solo en la tarjeta centrada; el de reproducir se
     aparta mientras el vídeo corre y vuelve al pasar el ratón o con el foco */
  .testi-card:not([data-active]) .testi-ctl {
    opacity: 0;
    pointer-events: none;
  }
  .testi-card[data-active][data-playing] .testi-play {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.9);
  }
  .testi-card[data-active][data-playing] .testi-play:focus-visible,
  .testi-card[data-active][data-playing]:hover .testi-play {
    opacity: 1;
    transform: translate(-50%, -50%);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .testi-card {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import { prefersReducedMotion } from '../../scripts/gsap'
  import { dragScroll, nearestIndex, onScrollEnd } from './scroller'

  const track = document.querySelector<HTMLElement>('[data-testi-track]')
  if (track) {
    const reduce = prefersReducedMotion()
    const cards = [...track.querySelectorAll<HTMLElement>('[data-testi]')]
    const vids = cards.map((c) => c.querySelector<HTMLVideoElement>('[data-testi-video]')!)
    let centers: number[] = []
    let act = -1
    let inView = false
    let userPaused = reduce
    let sound = false

    vids.forEach((v) => {
      v.controls = false
      v.muted = true
      v.tabIndex = -1
    })

    const layout = () => {
      const w = cards[0]?.offsetWidth ?? 0
      track.style.paddingInline = `${Math.max(0, (track.clientWidth - w) / 2)}px`
      centers = cards.map((el) => el.offsetLeft + el.offsetWidth / 2)
    }
    const go = (i: number) => {
      const k = (i + cards.length) % cards.length
      track.scrollTo({
        left: (centers[k] ?? 0) - track.clientWidth / 2,
        behavior: reduce ? 'auto' : 'smooth',
      })
    }

    const sync = () => {
      cards.forEach((c, i) => {
        const v = vids[i]!
        const on = i === act && inView && !userPaused
        if (on) {
          v.muted = !sound
          v.play().catch(() => {
            // Sin gesto previo el navegador puede negar el sonido: se sigue en silencio
            if (!v.muted) {
              v.muted = true
              sound = false
              paintSound()
              v.play().catch(() => {})
            }
          })
        } else if (!v.paused) v.pause()
      })
    }
    const paintSound = () =>
      cards.forEach((c) => {
        const b = c.querySelector<HTMLButtonElement>('[data-testi-sound]')
        if (!b) return
        b.setAttribute('aria-pressed', String(sound))
        b.setAttribute('aria-label', (sound ? b.dataset.on : b.dataset.off) ?? '')
      })
    const mark = (i: number) => {
      if (i === act) return
      cards[act]?.removeAttribute('data-active')
      cards[i]?.setAttribute('data-active', '')
      act = i
      cards.forEach((c, k) =>
        c.querySelector('[data-testi-sound]')?.setAttribute('tabindex', k === i ? '0' : '-1'),
      )
      sync()
    }

    vids.forEach((v, i) => {
      const card = cards[i]!
      const play = card.querySelector<HTMLButtonElement>('[data-testi-play]')
      const bar = card.querySelector<HTMLElement>('[data-testi-bar]')
      const paint = () => {
        const playing = !v.paused
        card.toggleAttribute('data-playing', playing)
        play?.setAttribute('aria-pressed', String(playing))
        play?.setAttribute('aria-label', (playing ? play.dataset.pause : play.dataset.play) ?? '')
      }
      v.addEventListener('play', paint)
      v.addEventListener('pause', paint)
      v.addEventListener('timeupdate', () => {
        if (bar && v.duration) bar.style.transform = `scaleX(${v.currentTime / v.duration})`
      })
      v.addEventListener('ended', () => {
        v.currentTime = 0
        if (bar) bar.style.transform = ''
        go(i + 1)
      })
    })

    // Pulsar: una lateral se centra; la centrada se pausa o reanuda
    track.addEventListener('click', (e) => {
      if (e.defaultPrevented) return
      const target = e.target as Element
      const li = target.closest<HTMLElement>('[data-testi]')
      const i = li ? cards.indexOf(li) : -1
      if (i < 0) return
      if (target.closest('[data-testi-sound]')) {
        sound = !sound
        paintSound()
        if (i === act) {
          userPaused = false
          sync()
        }
        return
      }
      if (i !== act) {
        userPaused = false
        go(i)
        return
      }
      userPaused = !vids[i]!.paused
      sync()
    })

    // Con el teclado, la tarjeta que recibe el foco se centra
    track.addEventListener('focusin', (e) => {
      const target = e.target as Element
      const li = target.closest<HTMLElement>('[data-testi]')
      const i = li ? cards.indexOf(li) : -1
      if (i >= 0 && i !== act && target.matches(':focus-visible')) go(i)
    })

    // Empieza por la del medio para que la pista quede equilibrada
    const first = Math.floor((cards.length - 1) / 2)
    layout()
    track.scrollLeft = (centers[first] ?? 0) - track.clientWidth / 2
    mark(first)
    paintSound()

    let raf = 0
    track.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(raf)
        raf = requestAnimationFrame(() => mark(nearestIndex(track, centers).index))
      },
      { passive: true },
    )
    const drag = dragScroll(track)
    onScrollEnd(track, () => {
      if (drag.busy()) return
      const { index, distance } = nearestIndex(track, centers)
      if (distance > 2) go(index)
    })

    new IntersectionObserver(
      ([en]) => {
        inView = !!en?.isIntersecting
        sync()
      },
      { threshold: 0.45 },
    ).observe(track)
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) vids.forEach((v) => v.pause())
      else sync()
    })

    let rt = 0
    window.addEventListener('resize', () => {
      window.clearTimeout(rt)
      rt = window.setTimeout(() => {
        layout()
        track.scrollLeft = (centers[act] ?? 0) - track.clientWidth / 2
      }, 120)
    })
  }
</script>
