---
import { Image } from 'astro:assets'
import sala from '../../assets/clinica-sala.jpg'
import BackButton from './BackButton.astro'
import Arrow from '../ui/Arrow.astro'
import { site, whatsappHref } from '../../data/site'
import { useT, type Lang } from '../../i18n'

// Página «Tu primera visita»: pasos, formas de pago y qué conviene saber.
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useT(lang)

const steps = [
  {
    n: '01',
    title: 'Llegada',
    time: '10 MIN',
    text: 'Te recibimos, completas una ficha breve con tus datos de salud y te ofrecemos algo de tomar.',
  },
  {
    n: '02',
    title: 'Valoración',
    time: '30 MIN',
    text: 'Alain Castellat, APRN, revisa tu piel, escucha lo que quieres mejorar y te explica las opciones con sus precios.',
  },
  {
    n: '03',
    title: 'Tu plan',
    time: '10 MIN',
    text: 'Te entregamos un plan con el tratamiento, el número de sesiones y el costo total, con opción de pagar en cuotas con Cherry.',
  },
  {
    n: '04',
    title: 'Tratamiento y seguimiento',
    time: 'SEGÚN EL TRATAMIENTO',
    text: 'Puedes empezar el mismo día o agendar para otra fecha. Después te escribimos para saber cómo sigues.',
  },
]

// Cherry: el enlace real cuando la clínica lo pase; mientras, preguntar por WhatsApp
const cherryHref = site.cherry || whatsappHref(lang, t('pago en cuotas con Cherry'))
const cherryLabel = site.cherry ? t('Solicitar con Cherry') : t('Pregunta por Cherry')

const payments = [
  {
    title: 'Por sesión',
    text: 'Pagas cada cita al terminar, con tarjeta o efectivo.',
    tags: ['Tarjeta', 'Efectivo'],
  },
  {
    title: 'Por paquete',
    text: 'Los paquetes de 4 u 8 sesiones salen más económicos que pagar una por una.',
    tags: ['4 sesiones', '8 sesiones'],
  },
  {
    title: 'En cuotas con Cherry',
    text: 'Divide tu paquete en pagos mensuales. La solicitud se hace desde el celular.',
    tags: ['Pagos mensuales', 'Desde el celular'],
    link: { href: cherryHref, label: cherryLabel },
  },
]

const tips = [
  'Llega 10 minutos antes para completar tu ficha.',
  'Trae la lista de medicamentos o tratamientos que uses.',
  'Si vienes por láser, evita el sol directo la semana anterior.',
  'Estacionamiento disponible frente a la clínica.',
]
---

<section
  data-theme="light"
  class="bg-cream text-ink grid grid-cols-[repeat(auto-fit,minmax(min(100%,460px),1fr))] items-end gap-[clamp(28px,4vw,64px)] px-gutter pt-[clamp(110px,14vh,140px)] pb-[clamp(40px,6vh,64px)]"
>
  <div class="flex flex-col items-start gap-[22px]">
    <BackButton lang={lang} tone="dark" />
    <h1
      data-words
      data-wdelay="80"
      class="font-display m-0 text-[clamp(40px,5.4vw,72px)] leading-[1.04] text-balance"
    >
      {t('Tu primera visita, paso a paso')}
    </h1>
  </div>
  <p data-reveal data-delay="450" class="text-body text-brown m-0 max-w-[520px] justify-self-end">
    {t(
      'Tu primera cita empieza con una valoración. Te explicamos qué tratamiento te conviene, cuántas sesiones necesitas y cuánto cuesta antes de empezar.',
    )}
  </p>
</section>

<section data-theme="light" class="bg-cream px-gutter pb-24">
  <div
    data-visit-photo
    class="bg-sand aspect-[4/5] overflow-hidden rounded-[14px] sm:aspect-[16/9] lg:aspect-[21/9]"
  >
    <Image
      src={sala}
      alt={t('Sala de tratamiento de la clínica GlowHaus')}
      widths={[480, 768]}
      sizes="100vw"
      data-visit-img
      class="size-full object-cover object-[50%_60%]"
    />
  </div>
</section>

<section id="visit-steps" data-theme="light" class="bg-cream text-ink px-gutter">
  <div data-vs class="relative flex flex-col pb-24 pl-[clamp(40px,4vw,64px)]">
    <h2 class="sr-only">{t('Paso a paso')}</h2>
    <div
      aria-hidden="true"
      class="bg-beige pointer-events-none absolute top-0 bottom-24 left-[clamp(10px,1.2vw,18px)] w-0.5 rounded-sm"
    >
      <div data-vs-fill class="vs-fill bg-gold absolute inset-0 origin-top rounded-sm"></div>
    </div>
    <ol class="m-0 list-none p-0">
      {steps.map((s) => (
        <li
          data-vs-row
          class="vs-row border-beige relative grid grid-cols-[auto_minmax(0,1fr)] items-baseline gap-x-6 gap-y-3 border-b py-9 md:grid-cols-[minmax(80px,120px)_minmax(0,1fr)_minmax(0,1.4fr)] md:gap-x-10"
        >
          <span
            aria-hidden="true"
            class="vs-dot absolute top-[58px] left-[calc(-1*clamp(40px,4vw,64px)+clamp(10px,1.2vw,18px)-6px)] size-3.5 rounded-full border-2"
          ></span>
          <span class="text-gold-dark text-[48px] leading-none font-semibold">{s.n}</span>
          <div class="flex flex-col gap-1.5">
            <h3 class="m-0 text-[24px] leading-[1.15] font-semibold">{t(s.title)}</h3>
            <span class="text-taupe text-[14.5px] font-semibold tracking-[0.12em]">
              {t(s.time)}
            </span>
          </div>
          <p class="text-body-sm text-brown col-span-full m-0 w-full max-w-[605px] md:col-span-1 md:justify-self-end">
            {t(s.text)}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>

<div
  data-theme="light"
  class="bg-sand text-ink flex min-h-screen flex-col justify-center gap-[clamp(56px,8vh,96px)] pt-[clamp(100px,12vh,120px)] pb-[clamp(56px,8vh,96px)]"
>
  <section data-theme="light" aria-labelledby="pay-title" class="px-gutter">
    <h2
      id="pay-title"
      data-words
      class="font-display m-0 mb-8 text-[clamp(30px,3.4vw,44px)] leading-[1.1] text-balance"
    >
      {t('Tres formas de pago')}
    </h2>
    <ul
      data-pay
      class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] gap-[22px] p-0"
    >
      {payments.map((p, i) => (
        <li
          data-reveal
          data-delay="120"
          data-pay-i={i}
          data-active={i === 0 ? '' : undefined}
          class="pay-card relative flex cursor-pointer flex-col gap-5 overflow-hidden rounded-[14px] border p-[clamp(22px,2.2vw,32px)] backdrop-blur-[14px]"
        >
          <h3 class="m-0 text-[clamp(22px,2vw,26px)] leading-[1.2] font-semibold">{t(p.title)}</h3>
          <p class="pay-sub m-0 text-[17.5px] leading-[1.6] text-pretty">{t(p.text)}</p>
          <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
            {p.tags.map((tag) => (
              <li class="pay-tag rounded-lg border px-3 py-[7px] text-[14.5px] font-medium">
                {t(tag)}
              </li>
            ))}
          </ul>
          {p.link && (
            <a
              href={p.link.href}
              target="_blank"
              rel="noopener"
              class="text-cream hover:text-gold-light mt-auto inline-flex items-center gap-2 self-start pt-1 text-[17px] font-semibold underline underline-offset-4 transition-colors"
            >
              <span>{p.link.label}</span>
              <Arrow />
            </a>
          )}
        </li>
      ))}
    </ul>
  </section>

  <section
    data-theme="light"
    class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,400px),1fr))] gap-14 px-gutter"
  >
    <div class="flex flex-col gap-[18px]">
      <span data-reveal class="eyebrow text-gold-dark">
        {t('ANTES DE VENIR')}
      </span>
      <h2
        data-words
        class="font-display m-0 max-w-[519px] text-[clamp(30px,3.4vw,44px)] leading-[1.1] text-balance"
      >
        {t('Lo que conviene saber')}
      </h2>
    </div>
    <ul class="border-ink text-body-sm text-brown m-0 flex list-none flex-col border-t p-0">
      {tips.map((tip) => (
        <li data-typerow class="border-beige flex items-baseline gap-3.5 border-b py-[18px]">
          <span
            data-dot
            aria-hidden="true"
            class="border-gold size-[9px] flex-none rounded-full border-[1.5px] bg-[rgb(168_132_79/0.25)]"
          ></span>
          <!-- El texto completo reserva el alto (sin saltos al escribirse) y es el que se lee -->
          <span class="grid min-w-0 flex-1">
            <span class="col-start-1 row-start-1 opacity-0">{t(tip)}</span>
            <span data-type aria-hidden="true" class="col-start-1 row-start-1">
              {t(tip)}
            </span>
          </span>
        </li>
      ))}
    </ul>
  </section>
</div>

<style>
  /* Pasos: sin JS o con movimiento reducido se ven todos encendidos */
  .vs-dot {
    background: var(--color-gold);
    border-color: var(--color-gold);
    transition:
      background 0.35s,
      border-color 0.35s,
      transform 0.35s;
  }
  :global(.js) .vs-row {
    opacity: 0.35;
    transition: opacity 0.45s;
  }
  :global(.js) .vs-row[data-on] {
    opacity: 1;
  }
  :global(.js) .vs-row:not([data-on]) .vs-dot {
    background: var(--color-sand);
    border-color: var(--color-beige);
  }
  :global(.js) .vs-row[data-on] .vs-dot {
    transform: scale(1.15);
  }
  :global(.js) .vs-fill {
    transform: scaleY(0);
  }

  /* Formas de pago (diseño: la activa en dorado, las demás en cristal oscuro).
     Los tonos van un punto más hondos que en el diseño para que el texto
     claro cumpla el contraste AA sobre el fondo arena. */
  .pay-card {
    --pay-bd: rgb(250 248 245 / 0.16);
    background: rgb(24 18 14 / 0.58);
    border-color: var(--pay-bd);
    color: var(--color-cream);
    transition:
      background 0.5s,
      color 0.5s,
      border-color 0.5s,
      translate 0.5s var(--ease-glow),
      box-shadow 0.5s;
  }
  .pay-card[data-active] {
    --pay-bd: rgb(250 248 245 / 0.35);
    background: color-mix(in srgb, var(--color-gold) 35%, var(--color-gold-dark));
  }
  .pay-sub,
  .pay-tag {
    color: var(--color-cream-2);
    transition:
      color 0.5s,
      border-color 0.5s;
  }
  .pay-tag {
    border-color: var(--pay-bd);
  }
  .pay-card[data-active] .pay-sub,
  .pay-card[data-active] .pay-tag {
    color: var(--color-cream);
  }
  /* «translate» y no «transform»: la aparición de GSAP usa transform */
  @media (hover: hover) and (pointer: fine) {
    .pay-card:hover {
      translate: 0 -6px;
      box-shadow: 0 14px 32px rgb(24 18 14 / 0.18);
    }
  }
</style>

<script>
  import { gsap, prefersReducedMotion } from '../../scripts/gsap'
  import { revealImage } from './page-motion'

  const reduce = prefersReducedMotion()

  // ---- Foto ancha: se descubre desde abajo y se asienta ----
  const frame = document.querySelector<HTMLElement>('[data-visit-photo]')
  if (frame) revealImage(frame, frame.querySelector<HTMLElement>('[data-visit-img]'))

  // ---- Paso a paso: fórmula del diseño ----
  // La punta de la línea va al 62 % de la pantalla: relleno = (vh·0,62 − top) /
  // (alto − 96). Una fila se enciende cuando su offsetTop + 65 ≤ esa punta.
  const vs = document.querySelector<HTMLElement>('[data-vs]')
  const fill = vs?.querySelector<HTMLElement>('[data-vs-fill]')
  const rows = vs ? [...vs.querySelectorAll<HTMLElement>('[data-vs-row]')] : []

  if (vs && fill) {
    if (reduce) {
      rows.forEach((r) => r.setAttribute('data-on', ''))
      fill.style.transform = 'scaleY(1)'
    } else {
      const setFill = gsap.quickTo(fill, 'scaleY', { duration: 0.35, ease: 'power3.out' })
      let raf = 0
      let near = false
      const update = () => {
        raf = 0
        const r = vs.getBoundingClientRect()
        const line = window.innerHeight * 0.62 - r.top
        setFill(Math.max(0, Math.min(1, line / (r.height - 96))))
        rows.forEach((row) => row.toggleAttribute('data-on', row.offsetTop + 65 <= line))
      }
      const queue = () => {
        if (near && !raf) raf = requestAnimationFrame(update)
      }
      new IntersectionObserver(
        ([e]) => {
          near = !!e?.isIntersecting
          if (raf) cancelAnimationFrame(raf)
          raf = 0
          update()
        },
        { rootMargin: '25% 0px' },
      ).observe(vs)
      window.addEventListener('scroll', queue, { passive: true })
      window.addEventListener('resize', queue)
    }
  }

  // ---- Formas de pago ----
  // Escritorio (≥760): la tarjeta activa rota cada 2,5 s; un clic la fija y pausa
  // la rotación 4 s. Solo corre con la sección en pantalla y la pestaña visible.
  // Móvil: la activa es la más cercana al centro de la pantalla.
  const pay = document.querySelector<HTMLElement>('[data-pay]')
  const cards = pay ? [...pay.querySelectorAll<HTMLElement>(':scope > [data-pay-i]')] : []
  if (pay && cards.length) {
    let idx = 0
    let pausedAt = 0
    let onScreen = false
    let timer = 0
    const setActive = (i: number) => {
      idx = i
      cards.forEach((c, k) => c.toggleAttribute('data-active', k === i))
    }
    const narrow = () => window.innerWidth < 760
    const tick = () => {
      if (document.hidden || !onScreen || narrow()) return
      if (Date.now() - pausedAt < 4000) return
      setActive((idx + 1) % cards.length)
    }
    const sync = () => {
      const run = !reduce && onScreen && !document.hidden && !narrow()
      if (run && !timer) timer = window.setInterval(tick, 2500)
      if (!run && timer) {
        clearInterval(timer)
        timer = 0
      }
    }
    cards.forEach((c, k) => {
      const pick = () => {
        pausedAt = Date.now()
        setActive(k)
      }
      c.addEventListener('click', pick)
      c.addEventListener('focusin', pick)
    })
    new IntersectionObserver(([e]) => {
      onScreen = !!e?.isIntersecting
      sync()
    }).observe(pay)
    document.addEventListener('visibilitychange', sync)
    let sraf = 0
    const nearest = () => {
      sraf = 0
      if (!narrow() || !onScreen) return
      const mid = window.innerHeight / 2
      let best = -1
      let bd = Infinity
      cards.forEach((c, k) => {
        const r = c.getBoundingClientRect()
        if (r.bottom < 0 || r.top > window.innerHeight) return
        const d = Math.abs(r.top + r.height / 2 - mid)
        if (d < bd) {
          bd = d
          best = k
        }
      })
      if (best >= 0 && best !== idx) setActive(best)
    }
    window.addEventListener(
      'scroll',
      () => {
        if (!sraf) sraf = requestAnimationFrame(nearest)
      },
      { passive: true },
    )
    window.addEventListener('resize', sync)
  }
</script>
