---
import Button from '../ui/Button.astro'
import { pathFor, useT, type Lang } from '../../i18n'

// «Atrás»: vuelve a la página anterior si viene del mismo sitio; si no (o sin JS),
// lleva a Inicio.
interface Props {
  lang: Lang
  tone?: 'light' | 'dark'
}
const { lang, tone = 'light' } = Astro.props
const t = useT(lang)
---

<Button href={pathFor(lang, 'home')} tone={tone} back data-back class="!px-[18px] !py-[11px]">
  {t('Atrás')}
</Button>

<style>
  /* La flecha se adelanta hacia atrás al pasar (escritorio). «translate» no
     choca con el giro de la flecha, que va en «transform». */
  :global(a[data-back] svg) {
    transition: translate 0.4s var(--ease-glow);
  }
  @media (hover: hover) and (pointer: fine) {
    :global(a[data-back]:hover svg) {
      translate: -4px -4px;
    }
  }
  :global(a[data-back]:focus-visible svg) {
    translate: -4px -4px;
  }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a[data-back]').forEach((a) => {
    a.addEventListener('click', (e) => {
      let sameOrigin = false
      try {
        sameOrigin = new URL(document.referrer).origin === location.origin
      } catch {
        sameOrigin = false
      }
      if (sameOrigin && history.length > 1) {
        e.preventDefault()
        history.back()
      }
    })
  })
</script>
