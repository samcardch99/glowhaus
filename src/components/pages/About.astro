---
import { Image } from 'astro:assets'
import alain from '../../assets/team/alain-sobre.jpg'
import BackButton from './BackButton.astro'
import Button from '../ui/Button.astro'
import { pathFor, useT, type Lang } from '../../i18n'

// Página «Sobre nosotros»: cómo empezó, valores y fundador.
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useT(lang)

const story = [
  'Antes de GlowHaus hubo un camino largo. Alain Castellat estudió medicina y, hace 25 años, dejó todo para empezar de nuevo en Estados Unidos. Aquí volvió a estudiar, se hizo enfermero registrado, sumó dos maestrías y llegó a ser Nurse Practitioner en Florida.',
  'La medicina estética siempre estuvo en su cabeza, pero emprender requiere inversión, tiempo y estar en el momento correcto. Durante años no lo fue. Hasta que un día todo encajó: el espacio, la oportunidad y la visión.',
  'Así nació GlowHaus. No como un medspa tradicional, sino como un boutique spa: un espacio pequeño, íntimo y refinado, donde se atiende a una sola persona a la vez y nadie mira el reloj.',
]

const values = [
  {
    n: '01',
    title: 'Una persona a la vez',
    text: 'Sin gente entrando y saliendo ni agendas llenas. Llegas y todo está preparado para ti.',
  },
  {
    n: '02',
    title: 'Sin prisas',
    text: 'No hay esperas ni interrupciones. Cada tratamiento se hace bien, a tu ritmo.',
  },
  {
    n: '03',
    title: 'Atención real',
    text: 'Te escuchamos y nos adaptamos a ti. Hay calma, privacidad y cada detalle está pensado.',
  },
]

const credentials = [
  "Bachelor's Degree in Nursing · Enfermero registrado",
  "Master's Degree in Healthcare Administration",
  "Master's in Nursing · Nurse Practitioner en el estado de la Florida",
]
---

<section data-theme="dark" class="bg-ink text-cream px-gutter pt-[clamp(110px,14vh,140px)]">
  <BackButton lang={lang} />
</section>

<section
  data-theme="dark"
  class="bg-ink text-cream relative flex flex-col gap-9 overflow-hidden px-gutter pt-[clamp(40px,6vh,64px)] pb-[clamp(72px,11vh,120px)]"
>
  <!-- Arco dorado de la «G» del isotipo, solo decorativo -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-[clamp(40px,6vh,64px)] bottom-[clamp(72px,11vh,120px)] left-[68%] z-0 hidden lg:block"
  >
    <svg viewBox="0 0 420 520" class="text-gold block h-full w-auto max-w-none opacity-[0.32]">
      <path
        fill="currentColor"
        fill-rule="evenodd"
        d="M10 260a250 255 0 1 0 500 0a250 255 0 1 0 -500 0ZM68 262a217 234 0 1 0 434 0a217 234 0 1 0 -434 0Z"
      ></path>
      <rect x="330" y="252" width="90" height="17" fill="currentColor"></rect>
    </svg>
  </div>

  <div class="relative z-[1] flex max-w-[780px] flex-col gap-[18px] pt-12">
    <span class="eyebrow text-beige">{t('CÓMO EMPEZÓ')}</span>
    <h1
      data-reveal
      class="font-display text-gold m-0 max-w-[919px] text-[clamp(30px,3.6vw,50px)] leading-[1.1]"
    >
      {t('Una idea que esperó su momento')}
    </h1>
  </div>
  <div class="relative z-[1] flex max-w-[780px] flex-col gap-[22px]">
    {story.map((p) => (
      <p
        data-reveal
        data-delay="200"
        class="text-cream-2 m-0 text-[length:var(--text-body)] leading-[1.75] text-pretty"
      >
        {t(p)}
      </p>
    ))}
    <Button href={pathFor(lang, 'contact')} class="mt-2 min-w-[min(100%,200px)] self-start">
      {t('Contáctanos')}
    </Button>
  </div>
</section>

<section data-theme="dark" class="bg-ink text-cream relative">
  <div class="px-gutter pt-[clamp(24px,4vh,48px)] pb-[120px]">
    <h2 class="sr-only">{t('Cómo trabajamos')}</h2>
    <div data-tl class="relative grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))]">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 top-0 hidden h-0.5 rounded-sm bg-[rgb(250_248_245/0.2)] md:block"
      >
        <div
          data-tl-fill
          class="bg-gold absolute inset-y-0 left-0 w-full origin-left rounded-sm"
        ></div>
      </div>
      {values.map((v) => (
        <div
          data-tl-step
          class="relative flex flex-col gap-4 border-t-2 border-[rgb(250_248_245/0.2)] pt-[clamp(28px,4vh,44px)] pr-7 pb-2 max-md:mb-6 md:border-t-0"
        >
          <span
            data-tl-dot
            aria-hidden="true"
            class="border-beige bg-gold absolute -top-[8px] left-0 size-3.5 rounded-full border-2 transition-[background,transform] duration-300 md:-top-1.5"
          />
          <span class="text-gold text-[clamp(44px,5vw,72px)] leading-none font-semibold">
            {v.n}
          </span>
          <h3 class="m-0 text-[21.5px] leading-tight font-semibold">{t(v.title)}</h3>
          <p class="text-body-sm text-sand-2 m-0 text-pretty">{t(v.text)}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section
  data-theme="light"
  class="bg-cream text-ink grid min-h-screen grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] items-center gap-[clamp(40px,6vw,96px)] px-gutter pt-[clamp(110px,14vh,150px)] pb-[clamp(56px,8vh,90px)]"
>
  <div class="flex flex-col gap-3 lg:hidden">
    <span class="eyebrow text-gold-dark">{t('FUNDADOR Y DIRECCIÓN MÉDICA')}</span>
    <h2 class="font-display m-0 text-[clamp(30px,3.6vw,50px)] leading-[1.1]">Alain Castellat</h2>
    <p class="m-0 text-[17px] font-semibold">{t('APRN, FNP-C · Nurse Practitioner en Florida')}</p>
  </div>
  <div class="bg-sand relative h-[min(calc(100vh-clamp(110px,14vh,150px)-clamp(56px,8vh,90px)),900px)] min-h-[420px] overflow-hidden rounded-[14px]">
    <Image
      src={alain}
      alt="Alain Castellat, APRN, FNP-C"
      widths={[480, 720, 960, 1216]}
      sizes="(min-width: 900px) 50vw, 100vw"
      class="absolute inset-0 size-full object-cover object-[center_30%]"
    />
  </div>
  <div class="flex max-w-[560px] flex-col gap-[22px]">
    <div class="hidden flex-col gap-3 lg:flex">
      <span data-reveal class="eyebrow text-gold-dark">
        {t('FUNDADOR Y DIRECCIÓN MÉDICA')}
      </span>
      <h2
        data-reveal
        data-delay="140"
        class="font-display m-0 text-[clamp(30px,3.6vw,50px)] leading-[1.1]"
      >
        Alain Castellat
      </h2>
      <p data-reveal data-delay="280" class="m-0 text-[18.5px] font-semibold">
        {t('APRN, FNP-C · Nurse Practitioner en Florida')}
      </p>
    </div>
    <p
      data-reveal
      data-delay="420"
      class="text-brown m-0 text-[clamp(17px,calc(12px+0.8vw),20px)] leading-[1.7] text-pretty"
    >
      {t(
        'Alain estudió medicina y hace 25 años lo dejó todo para venir a Estados Unidos buscando un futuro mejor para su familia. Aquí volvió a estudiar desde cero.',
      )}
    </p>
    <ol data-reveal data-delay="560" class="border-beige m-0 flex list-none flex-col border-t p-0">
      {credentials.map((c, i) => (
        <li class="border-beige flex gap-4 border-b py-3 text-[17.5px] leading-normal">
          <span class="text-gold-dark min-w-5 font-semibold">{String(i + 1).padStart(2, '0')}</span>
          <span>{t(c)}</span>
        </li>
      ))}
    </ol>
    <p
      data-reveal
      data-delay="700"
      class="text-brown m-0 text-[clamp(17px,calc(12px+0.8vw),20px)] leading-[1.7] text-pretty"
    >
      {t(
        'La medicina estética siempre lo llamó. Cuando por fin coincidieron el espacio, la oportunidad y la visión, nació GlowHaus.',
      )}
    </p>
    <blockquote data-reveal data-delay="840" class="m-0 mt-2">
      <p class="text-ink m-0 text-[clamp(20px,1.8vw,26px)] leading-[1.35] font-semibold text-balance">
        “{t('La estética no debería ser rápida. Debería ser toda una experiencia.')}”
      </p>
    </blockquote>
  </div>
</section>

<style>
  /* Sin JS o con movimiento reducido, los valores se ven completos */
  :global(.js) [data-tl-step] {
    opacity: 0.35;
    transition: opacity 0.45s;
  }
  :global(.js) [data-tl-step][data-on] {
    opacity: 1;
  }
  :global(.js) [data-tl-step]:not([data-on]) [data-tl-dot] {
    background: var(--color-sand);
  }
  :global(.js) [data-tl-step][data-on] [data-tl-dot] {
    transform: scale(1.15);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) [data-tl-step] {
      opacity: 1;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '../../scripts/gsap'

  // Línea dorada que se llena al bajar y enciende cada valor al pasar por él
  const wrap = document.querySelector<HTMLElement>('[data-tl]')
  const fill = wrap?.querySelector<HTMLElement>('[data-tl-fill]')
  const steps = wrap ? [...wrap.querySelectorAll<HTMLElement>('[data-tl-step]')] : []

  if (wrap && fill) {
    if (prefersReducedMotion()) {
      steps.forEach((s) => s.setAttribute('data-on', ''))
    } else {
      const mm = gsap.matchMedia()
      mm.add('(min-width: 768px)', () => {
        gsap.fromTo(
          fill,
          { scaleX: 0 },
          {
            scaleX: 1,
            ease: 'none',
            scrollTrigger: {
              trigger: wrap,
              start: 'top 85%',
              end: 'top 35%',
              scrub: true,
              onUpdate: (st) => {
                steps.forEach((s, i) =>
                  s.toggleAttribute('data-on', st.progress >= (i + 0.3) / steps.length),
                )
              },
            },
          },
        )
      })
      mm.add('(max-width: 767px)', () => {
        const triggers = steps.map((s) =>
          ScrollTrigger.create({
            trigger: s,
            start: 'top 80%',
            onEnter: () => s.setAttribute('data-on', ''),
            onLeaveBack: () => s.removeAttribute('data-on'),
          }),
        )
        return () => triggers.forEach((tr) => tr.kill())
      })
    }
  }
</script>
