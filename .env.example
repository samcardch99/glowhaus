# EmailJS (formulario de contacto). Son claves públicas: viajan al navegador.
# En el panel de EmailJS, limita los dominios permitidos (Account → Security).
# Sin ellas, el formulario abre WhatsApp con el mensaje ya escrito.
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=

# URL pública del sitio (canonical, sitemap). Por defecto, el dominio final.
# SITE_URL=https://darkgray-mandrill-714142.hostingersite.com
